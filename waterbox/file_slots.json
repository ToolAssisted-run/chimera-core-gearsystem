      "title": "slot.cart",
      "min": 1,
      "max": 1,
      "formats": [
        "sms",
        "bin",
        "rom"
      ],
      "help": "slot.cart_sms.help",
      "exposedWhen": {
        "setting": "system",
        "in": [
          "sms",
          "markIIILink"
        ]
      }
    },
