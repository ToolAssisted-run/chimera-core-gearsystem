{
  "coreName": "Gearsystem",
  "systemNames": {
    "SMS": "Master System",
    "GG": "Game Gear",
    "SG": "SG-1000",
    "GGL": "Game Gear Link",
    "M3L": "Mark III Link"
  },
  "author": "Ignacio Sanchez (Gearsystem); Chimera port by Sergio Martin",
  "url": "https://github.com/ToolAssisted-run/chimera-core-gearsystem",
  "runsOn": [
    "windows-x86_64",
    "linux-x86_64",
    "macos-x86_64",
    "windows-aarch64",
    "linux-aarch64",
    "macos-aarch64"
  ],
  "romFile": "rom",
  "deterministic": true,
  "memoryLayoutMiB": [
    32,
    4,
    4,
    4,
    32
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. Gearsystem allocates the cartridge (up to 8 MiB for the largest Korean multicarts) and its buffers with new; big blocks land on the mmap heap. waterbox/run-wbx.c uses the same numbers.",
  "video": {
    "_comment": "room for the largest picture (two Mark III pictures side by side, 512 wide; 288 high, the Master System's full overscan on a PAL machine); the size of each frame comes from GetVideoWidth/Height.",
    "width": 512,
    "height": 288,
    "virtualWidth": 293,
    "virtualHeight": 192,
    "vsyncNumerator": 3579545,
    "vsyncDenominator": 59736,
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "samplesPerFrame": 2048,
    "channels": 2,
    "rate": 44100,
    "get": "GetAudio"
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "_machines_note": "One core.wbx, five machines: Gearsystem is a Master System (and Mark III), a Game Gear and an SG-1000 (and SG-1000 II and Othello Multivision), the same program with other hardware chosen. Which one a session is comes from the system setting, so a project pins it and a movie cites it; the file's name never decides it. Two of them are two consoles in one, joined by their link cable (the owner, 2026-11-14): two Game Gears (Gear-to-Gear) and two Mark IIIs (the Joy-Joy cable on their SK-1100 keyboards).",
  "machineSetting": "system",
  "machines": [
    {
      "id": "SMS",
      "label": "Master System",
      "when": [
        "sms"
      ],
      "input": {
        "name": "Master System Controller",
        "_comment": "index order is the wire (waterbox/cinterface.cpp): the console's buttons, then two pads. The axes are the other controllers of the first port (Light Phaser, Paddle, Sports Pad) and the second port's Sports Pad; only the one the port setting plugs in is read. A phaser's trigger, the paddle's button and a Sports Pad's buttons are the pad's Button 1 and Button 2 of that port.",
        "buttons": [
          "Power",
          "Reset",
          "Pause",
          "P1 Up",
          "P1 Down",
          "P1 Left",
          "P1 Right",
          "P1 Button 1",
          "P1 Button 2",
          "P2 Up",
          "P2 Down",
          "P2 Left",
          "P2 Right",
          "P2 Button 1",
          "P2 Button 2"
        ],
        "mnemonics": {
          "Power": "P",
          "Reset": "r",
          "Pause": "p",
          "Up": "U",
          "Down": "D",
          "Left": "L",
          "Right": "R",
          "Button 1": "1",
          "Button 2": "2"
        },
        "axes": [
          {
            "name": "P1 Light Phaser X",
            "min": 0,
            "max": 65535,
            "neutral": 32768,
            "header": "GunX"
          },
          {
            "name": "P1 Light Phaser Y",
            "min": 0,
            "max": 65535,
            "neutral": 32768,
            "header": "GunY"
          },
          {
