        "tastudioColumns": [
          "Pause",
          "P1 Up",
          "P1 Down",
          "P1 Left",
          "P1 Right",
          "P1 Button 1",
          "P1 Button 2",
          "P2 Up",
          "P2 Down",
          "P2 Left",
          "P2 Right",
          "P2 Button 1",
          "P2 Button 2"
        ]
      },
