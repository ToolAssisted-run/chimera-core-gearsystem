            "neutral": 32768,
            "header": "Paddl"
          },
          {
            "name": "P1 Sports Pad X",
            "min": 0,
            "max": 65535,
            "neutral": 32768,
            "header": "SpX"
          },
          {
            "name": "P1 Sports Pad Y",
            "min": 0,
            "max": 65535,
            "neutral": 32768,
            "header": "SpY"
          },
          {
            "name": "P2 Sports Pad X",
